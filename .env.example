# Copy to .env at the repo root. Every workspace reads this one file.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://affix:affix@localhost:5432/affix

# Better Auth: generate a secret with `npx auth@1.7.6 secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
